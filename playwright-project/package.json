{
  "name": "aqa-advanced",
  "version": "1.0.0",
  "description": "test repo for \"hillel_js_for_qa\" course",
  "main": "index.js",
  "scripts": {
    "playwright:test": "playwright test",
    "playwright:test:headed": "playwright test --headed",
    "playwright:test:headed:chrome": "playwright test --headed --project='Google Chrome'",
    "playwright:test:ui": "playwright test --ui",
    "playwright:test:debug": "playwright test --debug",
    "playwright:test:chrome:ui:lesson-24": "playwright test e2e/lesson-24.spec.js --ui --project='Google Chrome'",
    "playwright:test:chrome:headed:lesson-24": "playwright test e2e/lesson-24.spec.js --headed --project='Google Chrome'",
    "playwright:test:chrome:headed:lesson-24:export_env": "export $(cat .env) && playwright test e2e/lesson-24.spec.js --headed --project='Google Chrome'",
    "playwright:test:chrome:headed:lesson-24:dotenv_config": "playwright test e2e/lesson-24.spec.js --headed --project='Google Chrome'",
    "playwright:test:chrome:headed:lesson-24:qauto1": "cross-env TEST_ENV=qauto1 playwright test e2e/lesson-24.spec.js --headed --project='Google Chrome'",
    "playwright:test:chrome:headed:lesson-24:qauto2": "cross-env TEST_ENV=qauto2 playwright test e2e/lesson-24.spec.js --headed --project='Google Chrome'",
    "playwright:test:chrome:headed:lesson-28:qauto1:chromeSetup": "cross-env TEST_ENV=qauto1 playwright test --headed --project='singleLoginChrome'",
    "playwright:test:chrome:ui:lesson-28:qauto1:chromeSetup": "cross-env TEST_ENV=qauto1 playwright test --ui --project='singleLoginChrome'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mykola-b-test/aqa-advanced.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/mykola-b-test/aqa-advanced/issues"
  },
  "homepage": "https://github.com/mykola-b-test/aqa-advanced#readme",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.0.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2"
  }
}
